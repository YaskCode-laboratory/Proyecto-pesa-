@startuml
' ============================================================
' DIAGRAMA DE COLABORACIÓN - Login de usuario (flujo principal)
' ============================================================

skinparam componentStyle rectangle

object Usuario
object FrontendApp
object "auth.php" as ApiAuth
object AuthDAO
object BitacoraDAO
object "PostgreSQL" as DB

' Enlaces numerados (orden de la interacción)
Usuario -> FrontendApp : 1: ingresa credenciales
FrontendApp -> ApiAuth : 2: POST login
ApiAuth -> AuthDAO : 3: buscarPorEmail()
AuthDAO -> DB : 4: SELECT usuarios
DB --> AuthDAO : 5: fila
AuthDAO --> ApiAuth : 6: ?array
ApiAuth -> AuthDAO : 7: crearSesion()
AuthDAO -> DB : 8: INSERT sesiones
DB --> AuthDAO : 9: OK
ApiAuth -> BitacoraDAO : 10: registrar('LOGIN')
BitacoraDAO --> ApiAuth : 11: (append logs/)
ApiAuth --> FrontendApp : 12: {token, userId, nombre}
FrontendApp --> Usuario : 13: pantalla principal

@enduml