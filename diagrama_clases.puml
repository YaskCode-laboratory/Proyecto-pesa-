@startuml
' ============================================================
' DIAGRAMA DE CLASES - Plataforma de Entrenamiento (PHP)
' Generado desde el código real del proyecto
' ============================================================

' Estilo
skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam classAttributeFontSize 11
skinparam defaultFontName "Segoe UI"
skinparam classBackgroundColor #F0F6FF
skinparam classBorderColor #2C3E50
skinparam style strictuml

' ---------------- CLASES DE PERSISTENCIA / ACCESO A DATOS ----------------

class Conexion {
  - instancia: ?PDO
  -- -- 
  - __construct()
  - __clone()
  + get(): PDO
}

class UsuarioDAO {
  + obtenerPorId(id: int): ?array
  + nivelYProgresion(id: int): ?array
  + guardarCuestionario(id: int, peso: float, edad: int, altura: float, genero: string, objetivo: string, nivel: string, dias: int)
  + activarProgresion(id: int, activo: bool)
  + xpYNivel(id: int): ?array
  + guardarXpYNivel(id: int, xp: int, nivel: int)
  + aplicarXp(id: int, xpGanado: int): array
}

class AuthDAO {
  + existeEmail(email: string): bool
  + crearUsuario(email: string, hash: string, nombre: string): array
  + buscarPorEmail(email: string): ?array
  + crearSesion(usuarioId: int, token: string, expires: string)
  + validarToken(token: ?string): ?int
  + usuarioPorToken(token: string): ?array
  + eliminarSesion(token: string)
  + buscarIdPorEmail(email: string): ?int
  + borrarResets(usuarioId: int)
  + crearReset(usuarioId: int, token: string, expires: string)
  + resetValido(token: string): ?int
  + actualizarPassword(usuarioId: int, hash: string)
  + marcarResetUsado(token: string)
}

class EjercicioDAO {
  + insertar(uid: int, nombre: string, peso: float, series: int, reps: int): array
  + nombreCatalogo(catalogoId: int): ?string
  + listarRecientes(uid: int): array
  + volumenTotal(uid: int): float
  + totalEjercicios(uid: int): int
  + eliminar(id: int, uid: int)
  + eliminarTodo(uid: int)
}

class PlantillaDAO {
  + listar(uid: int): array
  + buscarAccesible(plantillaId: int, uid: int): ?array
  + buscarConEjercicios(plantillaId: int, uid: int): ?array
  + ejerciciosDe(plantillaId: int): array
  + crear(nombre: string, descripcion: string, tipo: string, nivel: string, uid: int, dias: int, ejercicios: array): int
  + eliminar(plantillaId: int, uid: int): bool
  + activa(uid: int): ?array
  + catalogo(grupo: string): array
}

class SesionEntrenamientoDAO {
  + crear(uid: int, plantillaId: int, nivelPrev: int, ejercicios: array, factorNivel: float): int
  + obtener(sesionId: int, uid: int): ?array
  + ejerciciosDe(sesionId: int): array
  + nombrePlantilla(plantillaId: int): string
  + verificarAcceso(sesionEjercicioId: int, uid: int): bool
  + marcarCompletado(sesionEjercicioId: int, series: int, reps: string, peso: float)
  + ejercicioCatalogoId(sesionEjercicioId: int): ?int
  + iniciarDescanso(sesionEjercicioId: int)
  + finDescanso(sesionEjercicioId: int)
  + finalizar(sesionId: int, uid: int, xp: int, nivelNuevo: int)
}

class RecordDAO {
  + normalizar(nombre: string): string
  - metricas(peso: float, series: int, reps: int): array
  + registrarSiRecord(uid: int, nombre: string, peso: float, series: int, reps: int, ejercicioId: int): array
  + listarRecords(uid: int): array
  + racha(uid: int): array
  + totalRecords(uid: int): int
}

class LogroDAO {
  - DEFINICIONES: array
  + definiciones(): array
  - stats(uid: int): array
  - desbloqueados(uid: int): array
  + evaluar(uid: int): array
}

class BitacoraDAO {
  - RUTA: string = logs/actividad.log
  + registrar(uid: int, accion: string, detalle: string)
  + registrarAnonimo(accion: string, detalle: string)
  + listar(limite: int, uidFiltro: ?int): array
  - escribir(uid: ?int, email: string, accion: string, detalle: string)
}

' ---------------- CLASES DEL COMPONENTE WEB (cliente - HTML/JS) ----------------

class FrontendApp <<component>> {
  ..
  - token: string
  - historialEjerciciosAtleta: array
  - progresoChart: Chart
  .. sesión ..
  + stgGet(clave): any
  + stgSet(clave, valor)
  + stgDel(clave)
  + validarSesion()
  + manejarIngreso()
  .. flujo ..
  + navegarA(seccion)
  + cargarHistorial()
  + cargarActividad()
  + actualizarGraficasYMetricas()
  + initProgresoChart()
  + render(params: Object)
}

class API_Endpoints <<component>> {
  ..
  auth.php
  perfil.php
  ejercicios.php
  agregar_ejercicio.php
  plantillas.php
  sesiones.php
  records.php
  bitacora.php
  diagnostico.php
}

' ---------------- RELACIONES ----------------

Api_Endpoints -down-> AuthDAO : "usuario/sesión/reset"
Api_Endpoints -down-> UsuarioDAO : "perfil / xp / nivel"
Api_Endpoints -down-> EjercicioDAO : "historial / volumen"
Api_Endpoints -down-> PlantillaDAO : "plantillas / catálogo"
Api_Endpoints -down-> SesionEntrenamientoDAO : "sesiones activas"
Api_Endpoints -down-> RecordDAO : "récords / racha"
Api_Endpoints -down-> LogroDAO : "logros evaluados"
Api_Endpoints -down-> BitacoraDAO : "bitácora de actividad"

Conexion <.. AuthDAO : <<use>>
Conexion <.. UsuarioDAO : <<use>>
Conexion <.. EjercicioDAO : <<use>>
Conexion <.. PlantillaDAO : <<use>>
Conexion <.. SesionEntrenamientoDAO : <<use>>
Conexion <.. RecordDAO : <<use>>
Conexion <.. LogroDAO : <<use>>

FrontendApp -down-> API_Endpoints : "fetch() JSON (token)"

' Persistencia conceptual (base de datos)
note right of AuthDAO
  Tablas: usuarios, sesiones, password_resets
end note
note right of EjercicioDAO
  Tablas: ejercicios, historial
end note
note right of PlantillaDAO
  Tablas: ejercicios_catalogo, plantillas,
  plantilla_ejercicios
end note
note right of SesionEntrenamientoDAO
  Tablas: sesiones_entrenamiento,
  sesion_ejercicios
end note
note right of BitacoraDAO
  Persistencia: archivo plano
  logs/actividad.log (fuera del alcance
  de Live Server)
end note

@enduml